<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows only. Tells Windows this app is made for Windows 10 and 11.
  Without it, Windows may treat the app as an old program, which can break
  the Windows 11 look (Mica, rounded corners, transparency).
  Same file as in the official Avalonia app template.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="VokoAvalonia" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
