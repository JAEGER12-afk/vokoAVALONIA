<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VokoAvalonia</AssemblyName>
    <RootNamespace>VokoAvalonia</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Windows: marks the app as made for Windows 10/11 (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia: the cross-platform UI framework. -->
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <!-- FluentAvalonia: Windows 11 look (Mica window, settings cards, info bars, dark/light). -->
    <PackageReference Include="FluentAvaloniaUI" Version="2.*" />
  </ItemGroup>

</Project>
